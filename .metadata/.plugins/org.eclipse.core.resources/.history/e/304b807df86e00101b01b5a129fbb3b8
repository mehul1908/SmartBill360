package com.smartbill360.model;

import java.math.BigDecimal;

import jakarta.validation.constraints.NotNull;

import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@NoArgsConstructor
public class InvoiceItemRegModel {

	@NotNull(message="Product cannot be null")
	private Integer productId;
	
	@NotNull(message = "Quantity can not be null")
	private Integer quantity;
	
	private BigDecimal rate;
	
	private BigDecimal discInPer;
	
	public InvoiceItemRegModel(Integer productId , Integer quantity , BigDecimal rate , BigDecimal discInPer) {
		this.productId = productId;
		this.quantity = quantity;
		
		this.rate = rate;
		
		if(discInPer!=null) {
			this.discInPer = discInPer;
		}else {
			this.discInPer = 0.0f;
		}
	}
	
}
