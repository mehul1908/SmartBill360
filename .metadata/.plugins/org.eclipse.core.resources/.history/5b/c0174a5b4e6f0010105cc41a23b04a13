package com.smartbill360.modules.user.service;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;

import com.smartbill360.common.enums.Role;
import com.smartbill360.modules.user.entity.User;
import com.smartbill360.modules.user.repo.UserRepo;

public class UserServiceImpl implements UserService{
	
	@Autowired
	private UserRepo userRepo;

	public User getUserByEmail(String username) {
		Optional<User> userOp = userRepo.findById(username);
		if (userOp.isEmpty())
			return null;

		return userOp.get();
	}
	
	public List<User> getUserByRole(Role role) {
		List<User> users = userRepo.findByRole(role);
		return users;
		
	}
}
