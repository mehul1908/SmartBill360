package com.smartbill360.utilities;

import java.io.ByteArrayOutputStream;
import java.text.NumberFormat;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.List;
import java.util.Locale;

import com.itextpdf.kernel.pdf.PdfDocument;
import com.itextpdf.kernel.pdf.PdfWriter;
import com.itextpdf.layout.Document;
import com.itextpdf.layout.borders.Border;
import com.itextpdf.layout.element.Cell;
import com.itextpdf.layout.element.Paragraph;
import com.itextpdf.layout.element.Table;
import com.itextpdf.layout.properties.TextAlignment;
import com.itextpdf.layout.properties.UnitValue;
import com.smartbill360.entity.Consignee;
import com.smartbill360.entity.Invoice;
import com.smartbill360.entity.InvoiceItem;
import com.smartbill360.entity.User;

public class InvoicePDFGenerator {
	
	public static byte[] createInvoicePDF(Invoice invoice , Consignee consignee , List<InvoiceItem> items ) {
		ByteArrayOutputStream baos = new ByteArrayOutputStream();
		PdfWriter writer = new PdfWriter(baos);
		PdfDocument pdf = new PdfDocument(writer);
		Document document = new Document(pdf);
		
		// Header Title
        document.add(new Paragraph("INVOICE")
                .setBold().setFontSize(20).setTextAlignment(TextAlignment.CENTER));

        // Header Invoice Info
        Table headerTable = new Table(UnitValue.createPercentArray(new float[]{70, 30})).useAllAvailableWidth();
        headerTable.addCell(emptyCell().setBorder(Border.NO_BORDER));
        headerTable.addCell(new Cell()
                .add(new Paragraph("Invoice No: " + invoice.getInvoiceNo()))
                .add(new Paragraph("Date: " + invoice.getDate().format(DateTimeFormatter.ofPattern("dd-MM-yyyy"))))
                .setTextAlignment(TextAlignment.RIGHT)
                .setBorder(Border.NO_BORDER));
        document.add(headerTable);

        // Party Details
        Table partyDetail = new Table(UnitValue.createPercentArray(new float[]{50, 50})).useAllAvailableWidth();
        partyDetail.addHeaderCell(boldCell("Consignor Details:"));
        partyDetail.addHeaderCell(boldCell("Consignee Details:"));

        partyDetail.addCell(detailCell(ConsignorDetail.getName(), ConsignorDetail.getGst(), ConsignorDetail.getPhoneNo(), ConsignorDetail.getAddress(), ConsignorDetail.getEmail()));
        partyDetail.addCell(detailCell(consignee.getName(), consignee.getGstin(), consignee.getContact(), consignee.getAddress(), consignee.getEmail()));
        document.add(partyDetail);
        document.add(new Paragraph("\n"));

        // Invoice Items Table
        Table table = new Table(UnitValue.createPercentArray(new float[]{1, 5, 1.5f, 1, 1, 2, 2, 1, 2}))
                .useAllAvailableWidth();

        String[] headers = {"", "Product Name", "HSN Code", "Qty", "Tax%", "Rate/Item", "Tax Amt", "Disc%", "Amount"};
        for (String header : headers)
            table.addHeaderCell(boldCell(header).setTextAlignment(TextAlignment.CENTER));

        Float ro = Math.round(invoice.getTotalAmt()) - invoice.getTotalAmt();
        
        int counter = 1, totalQty = 0;
        for (InvoiceItem item : items) {
            table.addCell(cell(String.valueOf(counter++)));
            table.addCell(cell(item.getProduct().getName()));
            table.addCell(cell(item.getProduct().getHsnCode()));
            table.addCell(cell(String.valueOf(item.getQuantity())));
            table.addCell(cell(String.format("%.0f", item.getProduct().getTaxSlab().getSlab())));
            table.addCell(cell(String.format("%.2f", item.getRate())));
            table.addCell(cell(String.format("%.2f", item.getTax())));
            table.addCell(cell(String.format("%.2f", item.getDiscInPer())));
            table.addCell(cell(String.format("%.2f", item.getAmt())));
            totalQty += item.getQuantity();
        }
        
     // Round Off Row
        table.addCell(emptyCell());
        table.addCell(boldCell("Round Off"));
        table.addCell(emptyCell());
        table.addCell(emptyCell());
        table.addCell(emptyCell());
        table.addCell(emptyCell());
        table.addCell(emptyCell());
        table.addCell(emptyCell());
        table.addCell(cell(formatAmount(ro)));

        // Totals Row
        table.addCell(emptyCell());
        table.addCell(boldCell("Total"));
        table.addCell(emptyCell());
        table.addCell(cell(String.valueOf(totalQty)));
        table.addCell(emptyCell());
        table.addCell(emptyCell());
        table.addCell(cell(formatAmount(invoice.getTaxAmt())));
        table.addCell(emptyCell());
        table.addCell(cell(formatAmount(Math.round(invoice.getTotalAmt()))));

        document.add(table);
        document.add(new Paragraph("\n"));

        // Tax Summary
        document.add(new Paragraph("CGST: ₹" + formatAmount(0f)));
        document.add(new Paragraph("SGST: ₹" + formatAmount(0f)));
        document.add(new Paragraph("CESS: ₹" + formatAmount(0f)));
        document.add(new Paragraph("\n"));
        document.add(new Paragraph("Grand Total: ₹" + formatAmount(0f)).setBold().setFontSize(14));

        document.close();
        return baos.toByteArray();
	}
	
	// ------------------ Helper Methods ------------------

    private static Cell cell(String text) {
        return new Cell().add(new Paragraph(text));
    }

    private static Cell boldCell(String text) {
        return new Cell().add(new Paragraph(text).setBold());
    }

    private static Cell emptyCell() {
        return new Cell().add(new Paragraph());
    }

    private static Cell detailCell(String name, String gst, String phone, String address, String email) {
        return new Cell()
                .add(new Paragraph("Name : " + name))
                .add(new Paragraph("GST : " + gst))
                .add(new Paragraph("Phone No. : " + phone))
                .add(new Paragraph("Address : " + address))
                .add(new Paragraph("Email : " + email));
    }

    private static String formatAmount(float amount) {
        NumberFormat format = NumberFormat.getCurrencyInstance(new Locale("en", "IN"));
        return format.format(amount);
    }
	
}
