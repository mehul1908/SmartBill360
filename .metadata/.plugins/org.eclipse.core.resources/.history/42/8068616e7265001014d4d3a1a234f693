package com.smartbill360.utilities;

import java.io.ByteArrayOutputStream;
import java.text.NumberFormat;
import java.time.LocalDate;
import java.util.List;
import java.util.Locale;

import com.itextpdf.kernel.pdf.PdfDocument;
import com.itextpdf.kernel.pdf.PdfWriter;
import com.itextpdf.layout.Document;
import com.itextpdf.layout.borders.Border;
import com.itextpdf.layout.element.Cell;
import com.itextpdf.layout.element.Paragraph;
import com.itextpdf.layout.element.Table;
import com.itextpdf.layout.properties.TextAlignment;
import com.itextpdf.layout.properties.UnitValue;
import com.smartbill360.entity.Consignee;
import com.smartbill360.entity.Invoice;
import com.smartbill360.entity.InvoiceItem;
import com.smartbill360.entity.User;

public class InvoicePDFGenerator {
	
	public static byte[] createInvoicePDF(Invoice invoice , Consignee consignee , List<InvoiceItem> items ) {
		ByteArrayOutputStream baos = new ByteArrayOutputStream();
		PdfWriter writer = new PdfWriter(baos);
		PdfDocument pdf = new PdfDocument(writer);
		Document document = new Document(pdf);
		
		document.add(
				new Paragraph("INVOICE").setBold().setFontSize(20).setTextAlignment(TextAlignment.CENTER)
				);
		
		// Top-right Invoice Info Table
		Table headerTable = new Table(UnitValue.createPercentArray(new float[]{70, 30}))
		        .useAllAvailableWidth();

		headerTable.addCell(new Cell().add(new Paragraph()).setBorder(Border.NO_BORDER)); // Left empty cell
		Cell rightCell = new Cell()
		        .add(new Paragraph("Invoice No: " + invoice.getInvoiceNo()))
		        .add(new Paragraph("Date: " + invoice.getDate().toString()))
		        .setTextAlignment(TextAlignment.RIGHT)
		        .setBorder(Border.NO_BORDER);
		headerTable.addCell(rightCell);

		document.add(headerTable);
		
		//Buyer-Saler Detail
		
		Table partyDetail = new Table(UnitValue.createPercentArray(new float[] {50 , 50}))
				.useAllAvailableWidth();
		
		partyDetail.addHeaderCell(new Cell().add(new Paragraph("Consignor Details : ").setBold()));
		partyDetail.addHeaderCell(new Cell().add(new Paragraph("Consignee Details : ").setBold()));
		
		Cell consignorDetail = new Cell()
				.add(new Paragraph("Name : " + ConsignorDetail.getName()))
				.add(new Paragraph("GST : " + ConsignorDetail.getGst()))
				.add(new Paragraph("Phone No. : " + ConsignorDetail.getPhoneNo()))
				.add(new Paragraph("Address : " + ConsignorDetail.getAddress()))
				.add(new Paragraph("Email : " + ConsignorDetail.getEmail()));
		
		partyDetail.addCell(consignorDetail);
		
		Cell consigneeDetail = new Cell()
				.add(new Paragraph("Name : " + consignee.getName()))
				.add(new Paragraph("GST : " + consignee.getGstin()))
				.add(new Paragraph("Phone No. : " + consignee.getContact()))
				.add(new Paragraph("Address : " + consignee.getAddress()))
				.add(new Paragraph("Email : " + consignee.getEmail()));
		
		partyDetail.addCell(consigneeDetail);
		
		document.add(partyDetail);
		
        document.add(new Paragraph("\n"));
        
     // Table: Product, Qty, Price, Tax, Total
        Table table = new Table(UnitValue.createPercentArray(new float[]{1, 5, 1.5f, 1, 1, 2, 2, 1, 2}))
        	    .useAllAvailableWidth();

        	table.addHeaderCell(new Paragraph("").setBold()).setTextAlignment(TextAlignment.CENTER);
        	table.addHeaderCell(new Paragraph("Product Name").setBold()).setTextAlignment(TextAlignment.CENTER);
        	table.addHeaderCell(new Paragraph("HSN Code").setBold()).setTextAlignment(TextAlignment.CENTER);
        	table.addHeaderCell(new Paragraph("Qty").setBold()).setTextAlignment(TextAlignment.CENTER);
        	table.addHeaderCell(new Paragraph("Tax%").setBold()).setTextAlignment(TextAlignment.CENTER);
        	table.addHeaderCell(new Paragraph("Rate/Item").setBold()).setTextAlignment(TextAlignment.CENTER);
        	table.addHeaderCell(new Paragraph("Tax Amt").setBold()).setTextAlignment(TextAlignment.CENTER);
        	table.addHeaderCell(new Paragraph("Disc%").setBold()).setTextAlignment(TextAlignment.CENTER);
        	table.addHeaderCell(new Paragraph("Amount").setBold()).setTextAlignment(TextAlignment.CENTER);

        Integer counter = 1;
        
        Integer qtys = 0;
        

        for (InvoiceItem item : items) {
            table.addCell(new Cell().add(new Paragraph(String.valueOf(counter))));
            table.addCell(new Cell().add(new Paragraph(item.getProduct().getName())));
            table.addCell(new Cell().add(new Paragraph(item.getProduct().getHsnCode())));
            table.addCell(new Cell().add(new Paragraph(String.valueOf(item.getQuantity()))));
            table.addCell(new Cell().add(new Paragraph(String.format("%.0f",item.getProduct().getTaxSlab().getSlab()))));
            table.addCell(new Cell().add(new Paragraph(String.format("%.2f",item.getRate()))));
            table.addCell(new Cell().add(new Paragraph(String.format("%.2f",item.getTax()))));
            table.addCell(new Cell().add(new Paragraph(String.format("%.2f",item.getDiscInPer()))));
            table.addCell(new Cell().add(new Paragraph(String.format("%.2f",item.getAmt()))));
            qtys+=item.getQuantity();
            counter++;
        }
        
        table.addCell(new Cell().add(new Paragraph("")));
        table.addCell(new Cell().add(new Paragraph("Total").setBold()));
        table.addCell(new Cell().add(new Paragraph("")));
        table.addCell(new Cell().add(new Paragraph(String.valueOf(qtys))));
        table.addCell(new Cell().add(new Paragraph("")));
        table.addCell(new Cell().add(new Paragraph("")));
        table.addCell(new Cell().add(new Paragraph(String.format("%.2f",invoice.getTaxAmt()))));
        table.addCell(new Cell().add(new Paragraph("")));
        table.addCell(new Cell().add(new Paragraph(String.format("%.2f",invoice.getTotalAmt()))));
        

        document.add(table);
        document.add(new Paragraph("\n"));

        // Tax Summary
        NumberFormat formatter = NumberFormat.getCurrencyInstance(new Locale("en", "IN"));
         // ₹1,234.00
        document.add(new Paragraph("CGST: " + formatter.format(0.0f)));
        document.add(new Paragraph("SGST: ₹" + formatter.format(0.0f)));
        document.add(new Paragraph("CESS: ₹" + formatter.format(0.0f)));
        document.add(new Paragraph("\n"));

        document.add(new Paragraph("Grand Total: ₹" + formatter.format(0.0f))
                .setBold().setFontSize(14));

        document.close();
        return baos.toByteArray();
	}
	
}
